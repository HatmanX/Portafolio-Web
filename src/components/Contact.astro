---
const socials = [
  {
    name: "GitHub",
    url: "https://github.com/HatmanX",
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`,
    color: "#ffffff",
  },
  {
    name: "LinkedIn",
    url: "#", // <!-- reemplazar con URL real de LinkedIn -->
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
    color: "#0A66C2",
  },
  {
    name: "Email",
    url: "mailto:hatman@email.com", // <!-- reemplazar con email real -->
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
    color: "#00C896",
  },
];
---

<section
  id="contacto"
  class="py-24 relative"
  aria-label="Contacto"
>
  <!-- Glow decoration -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-[#00C896]/5 rounded-full blur-[80px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-16 reveal-on-scroll">
      <p class="font-mono text-[#00C896] text-sm mb-3">05. contacto</p>
      <h2 class="font-jetbrains font-bold text-4xl sm:text-5xl text-white">
        Hablemos<span class="text-[#00C896]">.</span>
      </h2>
      <p class="text-gray-400 mt-4 max-w-lg mx-auto leading-relaxed">
        ¿Tienes un proyecto en mente o quieres colaborar? Estoy disponible para
        proyectos freelance, oportunidades full-time y consultas técnicas.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <!-- Contact form -->
      <div class="reveal-on-scroll">
        <form
          id="contact-form"
          class="space-y-5 bg-[#161b22] border border-gray-800 rounded-xl p-8"
          novalidate
          aria-label="Formulario de contacto"
        >
          <div>
            <label
              for="name"
              class="block text-sm font-medium text-gray-400 mb-2"
            >
              Nombre <span class="text-[#00C896]">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              placeholder="Tu nombre completo"
              class="w-full px-4 py-3 bg-[#0d1117] border border-gray-700 rounded-lg text-gray-200 text-sm placeholder-gray-600 focus:outline-none focus:border-[#00C896] focus:ring-1 focus:ring-[#00C896]/30 transition-colors duration-200"
            />
          </div>

          <div>
            <label
              for="email"
              class="block text-sm font-medium text-gray-400 mb-2"
            >
              Email <span class="text-[#00C896]">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="tu@email.com"
              class="w-full px-4 py-3 bg-[#0d1117] border border-gray-700 rounded-lg text-gray-200 text-sm placeholder-gray-600 focus:outline-none focus:border-[#00C896] focus:ring-1 focus:ring-[#00C896]/30 transition-colors duration-200"
            />
          </div>

          <div>
            <label
              for="subject"
              class="block text-sm font-medium text-gray-400 mb-2"
            >
              Asunto
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="¿En qué puedo ayudarte?"
              class="w-full px-4 py-3 bg-[#0d1117] border border-gray-700 rounded-lg text-gray-200 text-sm placeholder-gray-600 focus:outline-none focus:border-[#00C896] focus:ring-1 focus:ring-[#00C896]/30 transition-colors duration-200"
            />
          </div>

          <div>
            <label
              for="message"
              class="block text-sm font-medium text-gray-400 mb-2"
            >
              Mensaje <span class="text-[#00C896]">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="Cuéntame sobre tu proyecto o consulta..."
              class="w-full px-4 py-3 bg-[#0d1117] border border-gray-700 rounded-lg text-gray-200 text-sm placeholder-gray-600 focus:outline-none focus:border-[#00C896] focus:ring-1 focus:ring-[#00C896]/30 transition-colors duration-200 resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full px-6 py-3.5 bg-[#00C896] text-[#0d1117] font-semibold rounded-lg hover:bg-[#00b085] transition-all duration-200 hover:shadow-[0_0_25px_rgba(0,200,150,0.3)] disabled:opacity-60 disabled:cursor-not-allowed flex items-center justify-center gap-2"
          >
            <span id="btn-text">Enviar mensaje</span>
            <svg
              id="btn-icon"
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
              ></path>
            </svg>
          </button>

          <!-- Success message (hidden by default) -->
          <div
            id="success-msg"
            class="hidden flex items-center gap-3 px-4 py-3 bg-[#00C896]/10 border border-[#00C896]/30 rounded-lg text-[#00C896] text-sm"
            role="alert"
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            ¡Mensaje enviado! Te responderé pronto. 🚀
          </div>
        </form>
      </div>

      <!-- Social links + info -->
      <div class="space-y-8 reveal-on-scroll">
        <div class="bg-[#161b22] border border-gray-800 rounded-xl p-8 space-y-6">
          <div>
            <h3 class="font-jetbrains font-semibold text-white mb-2">
              Respuesta rápida
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Respondo mensajes en menos de <span class="text-[#00C896] font-medium">24 horas</span>.
              Para proyectos urgentes, escríbeme directamente por email o LinkedIn.
            </p>
          </div>

          <!-- Social links -->
          <div>
            <p class="text-xs font-mono text-gray-500 uppercase tracking-wider mb-4">
              Encuéntrame en
            </p>
            <div class="space-y-3">
              {
                socials.map((social) => (
                  <a
                    href={social.url}
                    target={social.url.startsWith('http') ? '_blank' : undefined}
                    rel={social.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="flex items-center gap-4 p-3 rounded-lg border border-gray-800 hover:border-gray-600 transition-all duration-200 group"
                    aria-label={`Ir a ${social.name} de Hatman`}
                  >
                    <div
                      class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0 transition-colors duration-200"
                      style={`background: ${social.color}15; color: ${social.color};`}
                    >
                      <Fragment set:html={social.icon} />
                    </div>
                    <span class="text-gray-300 text-sm font-medium group-hover:text-white transition-colors duration-200">
                      {social.name}
                    </span>
                    <svg
                      class="w-4 h-4 text-gray-600 ml-auto group-hover:text-gray-400 group-hover:translate-x-1 transition-all duration-200"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                ))
              }
            </div>
          </div>

          <!-- Location -->
          <div class="pt-4 border-t border-gray-800 flex items-center gap-3 text-gray-500 text-sm">
            <span aria-hidden="true">📍</span>
            Lima, Perú 🇵🇪 — Disponible para trabajo remoto global
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text") as HTMLElement;
  const successMsg = document.getElementById("success-msg") as HTMLElement;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const name = (document.getElementById("name") as HTMLInputElement).value.trim();
    const email = (document.getElementById("email") as HTMLInputElement).value.trim();
    const message = (document.getElementById("message") as HTMLTextAreaElement).value.trim();

    if (!name || !email || !message) return;

    // Simulated send (UI only — no backend)
    submitBtn.disabled = true;
    btnText.textContent = "Enviando...";

    setTimeout(() => {
      form.reset();
      submitBtn.disabled = false;
      btnText.textContent = "Enviar mensaje";
      successMsg.classList.remove("hidden");
      setTimeout(() => successMsg.classList.add("hidden"), 6000);
    }, 1200);
  });
</script>
