---
const navLinks = [
  { href: "#inicio", label: "Inicio" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#contacto", label: "Contacto" },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  role="banner"
>
  <nav
    class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between"
    aria-label="Navegación principal"
  >
    <!-- Logo -->
    <a
      href="#inicio"
      class="font-jetbrains font-bold text-xl text-white flex items-center gap-2 group"
      aria-label="Ir al inicio"
    >
      <span
        class="text-[#00C896] transition-transform duration-300 group-hover:scale-110"
        >&lt;</span
      >
      <span>Hatman</span>
      <span
        class="text-[#00C896] transition-transform duration-300 group-hover:scale-110"
        >/&gt;</span
      >
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden md:flex items-center gap-8" role="list">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-gray-400 hover:text-[#00C896] transition-colors duration-200 text-sm font-medium relative group"
            >
              {link.label}
              <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#00C896] transition-all duration-300 group-hover:w-full" />
            </a>
          </li>
        ))
      }
    </ul>

    <!-- CTA Button -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href="#contacto"
        class="px-5 py-2 bg-[#00C896] text-[#0d1117] font-semibold text-sm rounded-lg hover:bg-[#00b085] transition-all duration-200 hover:shadow-[0_0_20px_rgba(0,200,150,0.3)]"
      >
        Contrátame
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2 group"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span
        class="block w-6 h-0.5 bg-gray-300 transition-all duration-300 group-[.open]:rotate-45 group-[.open]:translate-y-2"
      ></span>
      <span
        class="block w-6 h-0.5 bg-gray-300 transition-all duration-300 group-[.open]:opacity-0"
      ></span>
      <span
        class="block w-6 h-0.5 bg-gray-300 transition-all duration-300 group-[.open]:-rotate-45 group-[.open]:-translate-y-2"
      ></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-[#161b22] border-t border-gray-800"
    aria-label="Menú móvil"
  >
    <ul class="flex flex-col px-6 py-4 gap-4" role="list">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-gray-300 hover:text-[#00C896] transition-colors duration-200 block py-1"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2 border-t border-gray-800">
        <a
          href="#contacto"
          class="block w-full text-center px-5 py-2.5 bg-[#00C896] text-[#0d1117] font-semibold text-sm rounded-lg"
        >
          Contrátame
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const navbar = document.getElementById("navbar");
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  // Scroll effect: sólida con sombra al hacer scroll
  window.addEventListener("scroll", () => {
    if (window.scrollY > 20) {
      navbar?.classList.add(
        "bg-[#0d1117]/95",
        "backdrop-blur-md",
        "shadow-lg",
        "shadow-black/20",
        "border-b",
        "border-gray-800/50"
      );
    } else {
      navbar?.classList.remove(
        "bg-[#0d1117]/95",
        "backdrop-blur-md",
        "shadow-lg",
        "shadow-black/20",
        "border-b",
        "border-gray-800/50"
      );
    }
  });

  // Mobile menu toggle
  menuBtn?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.contains("hidden") === false;
    if (isOpen) {
      mobileMenu?.classList.add("hidden");
      menuBtn.setAttribute("aria-expanded", "false");
      menuBtn.classList.remove("open");
    } else {
      mobileMenu?.classList.remove("hidden");
      menuBtn.setAttribute("aria-expanded", "true");
      menuBtn.classList.add("open");
    }
  });

  // Cerrar menú al hacer clic en un link
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.add("hidden");
      menuBtn?.setAttribute("aria-expanded", "false");
      menuBtn?.classList.remove("open");
    });
  });
</script>
