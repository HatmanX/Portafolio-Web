---
import { skillCategories } from '../data/skills';
---

<section
  id="habilidades"
  class="py-24 bg-[#0a0e13] relative"
  aria-label="Habilidades y herramientas"
>
  <!-- Top fade -->
  <div class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-[#0d1117] to-transparent pointer-events-none"></div>
  <!-- Bottom fade -->
  <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-[#0d1117] to-transparent pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-16 reveal-on-scroll">
      <p class="font-mono text-[#00C896] text-sm mb-3">02. habilidades</p>
      <h2 class="font-jetbrains font-bold text-4xl sm:text-5xl text-white">
        Stack y herramientas<span class="text-[#00C896]">.</span>
      </h2>
      <p class="text-gray-500 mt-4 max-w-xl mx-auto">
        Tecnologías que uso en mi día a día, organizadas por categoría.
      </p>
    </div>

    <!-- Categories grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        skillCategories.map((category, catIndex) => (
          <div
            class="skill-card bg-[#161b22] border border-gray-800 rounded-xl p-6 hover:border-[#00C896]/30 transition-all duration-300 hover:shadow-[0_0_30px_rgba(0,200,150,0.05)]"
            data-delay={catIndex * 80}
          >
            <div class="flex items-center gap-3 mb-5">
              <span class="text-2xl" aria-hidden="true">{category.emoji}</span>
              <h3 class="font-jetbrains font-semibold text-white text-sm uppercase tracking-wider">
                {category.title}
              </h3>
            </div>

            <div class="flex flex-wrap gap-2">
              {category.skills.map((skill) => (
                <span
                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-mono font-medium transition-all duration-200 hover:scale-105 cursor-default"
                  style={`
                    background-color: ${skill.color}18;
                    border: 1px solid ${skill.color}30;
                    color: ${skill.color === '#ffffff' ? '#e5e7eb' : skill.color};
                  `}
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full flex-shrink-0"
                    style={`background-color: ${skill.color === '#ffffff' ? '#e5e7eb' : skill.color}`}
                    aria-hidden="true"
                  />
                  {skill.name}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Intersection Observer para animación de entrada progresiva
  const cards = document.querySelectorAll<HTMLElement>('.skill-card');
  cards.forEach((card) => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(24px)';
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const card = entry.target as HTMLElement;
          const delay = parseInt(card.dataset.delay || '0');
          setTimeout(() => {
            card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
          }, delay);
          observer.unobserve(card);
        }
      });
    },
    { threshold: 0.1 }
  );

  cards.forEach((card) => observer.observe(card));
</script>
