---
const quickFacts = [
  { icon: "📍", label: "Ubicación", value: "Lima, Perú 🇵🇪" },
  { icon: "💼", label: "Disponibilidad", value: "Freelance / Full-time" },
  { icon: "🌐", label: "Idiomas", value: "Español (nativo) · Inglés (básico)" },
  { icon: "🎯", label: "Especialidades", value: "SAP ABAP · Full Stack · UI/UX · Game Dev" },
];
---

<section
  id="sobre-mi"
  class="py-24 relative"
  aria-label="Sobre mí"
>
  <!-- Section separator line -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-16 bg-gradient-to-b from-transparent to-[#00C896]/30"></div>

  <div class="max-w-6xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-16 reveal-on-scroll">
      <p class="font-mono text-[#00C896] text-sm mb-3">01. sobre mí</p>
      <h2 class="font-jetbrains font-bold text-4xl sm:text-5xl text-white">
        ¿Quién soy<span class="text-[#00C896]">?</span>
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <!-- Bio text -->
      <div class="space-y-6 reveal-on-scroll">
        <div class="space-y-4 text-gray-400 leading-relaxed">
          <p>
            Soy <span class="text-white font-semibold">Hatman</span>, un desarrollador Full Stack
            apasionado por construir software que realmente importa. Me especializo en
            <span class="text-[#00C896]">SAP ABAP</span> para entornos empresariales,
            desarrollo web y móvil con múltiples stacks, diseño UI/UX en
            <span class="text-[#00C896]">Figma</span>, y — por diversión —
            creo videojuegos en <span class="text-[#00C896]">Godot Engine 4.x</span>.
          </p>
          <p>
            Actualmente trabajo en <span class="text-white font-semibold">Rensar Consulting</span>
            desarrollando soluciones ABAP en entorno productivo, mientras sigo explorando
            nuevas tecnologías y tomando proyectos freelance donde pueda aportar valor real.
          </p>
          <p>
            Creo que el código bien escrito es una forma de arte: debe ser limpio, mantenible
            y escalable. No solo que funcione — sino que cualquier otro developer lo entienda
            la primera vez que lo lee.
          </p>
        </div>

        <!-- CV download -->
        <a
          href="#"
          class="inline-flex items-center gap-3 px-6 py-3 border border-[#00C896]/40 text-[#00C896] rounded-lg hover:bg-[#00C896]/10 transition-all duration-200 group font-medium"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Descargar CV de Hatman"
        >
          <svg
            class="w-5 h-5 group-hover:animate-bounce"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          Descargar CV
        </a>
      </div>

      <!-- Quick facts -->
      <div class="space-y-4 reveal-on-scroll">
        <div
          class="bg-[#161b22] border border-gray-800 rounded-xl p-6 space-y-5"
        >
          <h3 class="font-jetbrains font-semibold text-white text-sm uppercase tracking-widest text-[#00C896]">
            Datos rápidos
          </h3>
          <ul class="space-y-4" role="list">
            {
              quickFacts.map((fact) => (
                <li class="flex items-start gap-4">
                  <span class="text-xl flex-shrink-0 mt-0.5" aria-hidden="true">{fact.icon}</span>
                  <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider mb-0.5">
                      {fact.label}
                    </p>
                    <p class="text-gray-200 text-sm font-medium">{fact.value}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Tech chips row -->
        <div class="bg-[#161b22] border border-gray-800 rounded-xl p-6">
          <h3 class="font-jetbrains font-semibold text-sm uppercase tracking-widest text-[#00C896] mb-4">
            Actualmente trabajando con
          </h3>
          <div class="flex flex-wrap gap-2">
            {
              ["SAP ABAP", "Astro", "TailwindCSS", "TypeScript", "Figma", "Godot 4.x"].map(
                (tech) => (
                  <span class="px-3 py-1 bg-[#0d1117] border border-gray-700 rounded-full text-xs text-gray-300 font-mono">
                    {tech}
                  </span>
                )
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
