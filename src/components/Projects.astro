---
import { projects } from '../data/projects';

const categoryColorMap: Record<string, string> = {
  accent:  { bg: 'rgba(0,200,150,0.12)',  border: 'rgba(0,200,150,0.35)',  text: '#00C896'  },
  blue:    { bg: 'rgba(15,170,255,0.12)', border: 'rgba(15,170,255,0.35)', text: '#0FAAFF'  },
  purple:  { bg: 'rgba(167,139,250,0.12)',border: 'rgba(167,139,250,0.35)',text: '#a78bfa'  },
  yellow:  { bg: 'rgba(251,191,36,0.12)', border: 'rgba(251,191,36,0.35)', text: '#fbbf24'  },
} as any;

function getCategoryStyle(colorKey: string) {
  const c = categoryColorMap[colorKey] || categoryColorMap['accent'];
  return `background:${c.bg};border:1px solid ${c.border};color:${c.text}`;
}
---

<section
  id="proyectos"
  class="py-24 relative"
  aria-label="Proyectos"
>
  <div class="max-w-6xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-16 reveal-on-scroll">
      <p class="font-mono text-[#00C896] text-sm mb-3">03. proyectos</p>
      <h2 class="font-jetbrains font-bold text-4xl sm:text-5xl text-white">
        Lo que he construido<span class="text-[#00C896]">.</span>
      </h2>
      <p class="text-gray-500 mt-4 max-w-xl mx-auto">
        Una selección de proyectos personales y profesionales. Cada uno resuelve un problema real.
      </p>
    </div>

    <!-- Projects grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        projects.map((project, index) => (
          <article
            class="project-card group relative bg-[#161b22] border border-gray-800 rounded-xl overflow-hidden flex flex-col hover:border-[#00C896]/40 transition-all duration-300 hover:shadow-[0_8px_40px_rgba(0,200,150,0.08)] hover:-translate-y-1"
            data-delay={index * 100}
          >
            <!-- Thumbnail placeholder with gradient -->
            <div class="relative h-44 overflow-hidden">
              <div
                class="absolute inset-0 flex items-center justify-center"
                style={`background: linear-gradient(135deg, #161b22 0%, #1c2128 100%)`}
              >
                <!-- Category badge in thumbnail -->
                <div class="text-center">
                  <div class="text-4xl mb-2">
                    {project.category.includes('SAP') ? '🏢' :
                     project.category.includes('Mobile') ? '📱' :
                     project.category.includes('Game') ? '🎮' :
                     project.category.includes('Intelligence') ? '📊' : '💻'}
                  </div>
                  <p class="font-mono text-xs text-gray-600">{project.stack[0]}</p>
                </div>
              </div>

              <!-- Hover overlay -->
              <div class="absolute inset-0 bg-[#00C896]/8 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

              <!-- Category badge -->
              <div class="absolute top-3 left-3">
                <span
                  class="px-2.5 py-1 rounded-md text-xs font-mono font-semibold"
                  style={getCategoryStyle(project.categoryColor)}
                >
                  {project.category}
                </span>
              </div>

              <!-- Featured star -->
              {project.featured && (
                <div class="absolute top-3 right-3">
                  <span class="text-[#fbbf24] text-sm" aria-label="Proyecto destacado">⭐</span>
                </div>
              )}
            </div>

            <!-- Card body -->
            <div class="p-5 flex flex-col flex-1 gap-4">
              <div>
                <h3 class="font-jetbrains font-bold text-lg text-white group-hover:text-[#00C896] transition-colors duration-200">
                  {project.title}
                </h3>
                <p class="text-gray-400 text-sm mt-2 leading-relaxed line-clamp-3">
                  {project.description}
                </p>
              </div>

              <!-- Tech stack tags -->
              <div class="flex flex-wrap gap-1.5 mt-auto">
                {project.stack.map((tech) => (
                  <span class="px-2 py-0.5 bg-[#0d1117] border border-gray-700 rounded text-xs text-gray-400 font-mono">
                    {tech}
                  </span>
                ))}
              </div>

              <!-- Action buttons -->
              <div class="flex gap-3 pt-1 border-t border-gray-800">
                {project.hasDemo ? (
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-[#00C896] text-[#0d1117] text-xs font-semibold rounded-lg hover:bg-[#00b085] transition-colors duration-200"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    {project.demoLabel}
                  </a>
                ) : (
                  <span class="flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-gray-800 text-gray-500 text-xs font-semibold rounded-lg cursor-not-allowed">
                    {project.demoLabel}
                  </span>
                )}

                {project.hasCode ? (
                  <a
                    href={project.codeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 flex items-center justify-center gap-2 px-3 py-2 border border-gray-700 text-gray-300 text-xs font-semibold rounded-lg hover:border-[#00C896] hover:text-[#00C896] transition-all duration-200"
                  >
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    {project.codeLabel}
                  </a>
                ) : (
                  <span class="flex-1 flex items-center justify-center gap-2 px-3 py-2 border border-gray-800 text-gray-600 text-xs font-semibold rounded-lg cursor-not-allowed">
                    {project.codeLabel}
                  </span>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="text-center mt-12 reveal-on-scroll">
      <p class="text-gray-500 mb-4">¿Quieres ver más proyectos?</p>
      <a
        href="https://github.com/HatmanX"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-6 py-3 border border-gray-700 text-gray-300 rounded-lg hover:border-[#00C896] hover:text-[#00C896] transition-all duration-200 font-medium"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        Ver GitHub — @HatmanX
      </a>
    </div>
  </div>
</section>

<script>
  // Scroll reveal for project cards
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  cards.forEach((card) => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(28px)';
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const card = entry.target as HTMLElement;
          const delay = parseInt(card.dataset.delay || '0');
          setTimeout(() => {
            card.style.transition = 'opacity 0.55s ease, transform 0.55s ease, border-color 0.3s, box-shadow 0.3s, translate 0.3s';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
          }, delay);
          observer.unobserve(card);
        }
      });
    },
    { threshold: 0.08 }
  );

  cards.forEach((card) => observer.observe(card));
</script>
